---
const navItems = [
  { label: "About", href: "/about/" },
  { label: "Programs", href: "/programs/" },
  { label: "Membership", href: "/membership/" },
  { label: "Cardennes", href: "/cardennes/" },
  { label: "Support", href: "/support/" },
  { label: "Partner", href: "/partner/" },
  { label: "Contact", href: "/contact/" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Georgia Film Society home">
      <span class="site-header__mark">GFS</span>
      <span class="site-header__name">Georgia Film Society</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="site-header__cta" href="/contact/">
      Stay Connected
    </a>
  </div>
</header>